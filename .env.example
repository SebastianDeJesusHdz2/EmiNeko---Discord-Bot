# Obligatorio para Discord
DISCORD_TOKEN=PEGA_TU_TOKEN_AQUI
BOT_PREFIX=!
BOT_DB_PATH=otakubot_data.db
# Steam: importa bibliotecas visibles (opcional)
STEAM_API_KEY=
# Cine: API Read Access Token de TMDB (opcional)
TMDB_TOKEN=
# Biblioteca automática exportada por Playnite (opcional)
PLAYNITE_EXPORT_PATH=
PLAYNITE_DISCORD_USER_ID=
# Sala web opcional. Mantén 127.0.0.1 y usa túnel HTTPS para invitados remotos
EMI_WEB_ENABLED=0
EMI_WEB_HOST=127.0.0.1
EMI_WEB_PORT=8765
EMI_WEB_PUBLIC_URL=http://127.0.0.1:8765
